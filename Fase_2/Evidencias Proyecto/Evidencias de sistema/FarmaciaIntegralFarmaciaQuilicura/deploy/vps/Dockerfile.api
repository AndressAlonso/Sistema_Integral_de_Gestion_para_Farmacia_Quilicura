FROM python:3.12-slim

USER root
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY backend/requirements.txt ./requirements.txt
RUN pip install -r requirements.txt

RUN useradd --uid 10001 --create-home appuser \
    && mkdir -p /app/media/products \
    && chown -R appuser:appuser /app/media

COPY backend/app ./app
COPY backend/migrations ./migrations
COPY backend/alembic.ini ./alembic.ini
COPY deploy/vps/bootstrap_admin.py ./bootstrap_admin.py

RUN chmod -R a+rX /app/app /app/migrations \
    && chmod a+r /app/alembic.ini /app/bootstrap_admin.py /app/requirements.txt

USER appuser
EXPOSE 8000

CMD ["uvicorn", "app.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*", "--no-access-log"]
