# Generate a private key; never commit .env (see README).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=540
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=sigfq
DB_USER=sigfq
DB_PASSWORD=
# E5: la promoción está desactivada si no se configura un producto.
# Para demo local: APP_ENVIRONMENT=development y POS_DEMO_PRODUCT_ID=<UUID real>.
APP_ENVIRONMENT=production

# E7-H3: solo administradores; requiere APP_ENVIRONMENT=development
ORDER_PAYMENT_SIMULATION=false

# Mercado Pago: completar con la cuenta de prueba y la dirección HTTPS pública.
# Al habilitar pagos, habilitar también la revisión automática de reservas.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PUBLIC_BASE_URL=
MP_CHECKOUT_ENABLED=false
MP_EXPIRATION_ENABLED=false

# Correos E7-H5. Para un buzón SMTP local: enabled=true, starttls=false.
# En un proveedor externo usar TLS y configurar las credenciales solo en .env.
ORDER_MAIL_ENABLED=false
ORDER_MAIL_HOST=127.0.0.1
ORDER_MAIL_PORT=1025
ORDER_MAIL_SENDER=pedidos@farmacia.example
ORDER_MAIL_STARTTLS=true
ORDER_MAIL_SSL=false
# ORDER_MAIL_USERNAME=
# ORDER_MAIL_PASSWORD=
ORDER_MAIL_REMINDER_ENABLED=false
ORDER_MAIL_REMINDER_HOURS=24
